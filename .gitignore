# ============================================================
# Root .gitignore for UNIV-Resolve
# Covers: Rag_Project (Python/RAG) + univresolve (React + Spring Boot)
# ============================================================

# ----------------------------
# Python (Rag_Project)
# ----------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
Rag_Project/venv/
Rag_Project/.venv/
venv/
.venv/
env/
ENV/

# Environment variables / secrets
.env
.env.*
!.env.example

# ChromaDB / vector store data
Rag_Project/db/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/
wheels/

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# MyPy / type checkers
.mypy_cache/
.dmypy.json
dmypy.json

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb

# ----------------------------
# Node / React (univresolve/client)
# ----------------------------
node_modules/
dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ----------------------------
# Java / Spring Boot (univresolve/resolve)
# ----------------------------
target/
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Gradle (if added later)
.gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# ----------------------------
# IDE & Editor
# ----------------------------
# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# IntelliJ IDEA / STS / NetBeans
.idea/
*.iws
*.iml
*.ipr
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/

# ----------------------------
# OS & misc
# ----------------------------
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
